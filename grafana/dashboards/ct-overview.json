{
  "uid": "ct-overview",
  "title": "CT Monitoring — Overview",
  "tags": ["ct", "cert-monitoring"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unique certificates (all time)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT uniq(sha256) AS unique_certs FROM ct.certs"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique domains (all time)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT uniq(domain) AS unique_domains FROM ct.domain_certs"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Missing entries (gaps)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT sum(span - distinct_idx) AS missing_entries FROM (SELECT source_url, max(cert_index) - min(cert_index) + 1 AS span, uniqExact(cert_index) AS distinct_idx FROM ct.cert_sightings GROUP BY source_url)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Certificates ingested / minute",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfMinute(seen) AS time, count() AS certs FROM ct.certs WHERE $__timeFilter(seen) GROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top root domains (selected time range)",
      "gridPos": { "h": 11, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0 }, "overrides": [ { "matcher": { "id": "byName", "options": "root_domain" }, "properties": [ { "id": "unit", "value": "string" } ] } ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT cutToFirstSignificantSubdomain(domain) AS root_domain, uniq(sha256) AS certs, uniq(domain) AS names FROM ct.domain_certs WHERE $__timeFilter(seen) GROUP BY root_domain ORDER BY certs DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top issuers (selected time range)",
      "gridPos": { "h": 11, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0 }, "overrides": [ { "matcher": { "id": "byName", "options": "issuer" }, "properties": [ { "id": "unit", "value": "string" } ] } ] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT issuer_o AS issuer, count() AS certs FROM ct.certs WHERE issuer_o != '' AND $__timeFilter(seen) GROUP BY issuer ORDER BY certs DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Certificate validity length by issuer (5-day bins, selected range)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
      "fieldConfig": { "defaults": { "unit": "locale", "decimals": 0, "color": { "mode": "palette-classic" }, "custom": { "stacking": { "mode": "normal", "group": "A" }, "fillOpacity": 90, "lineWidth": 0 } }, "overrides": [] },
      "options": { "xField": "validity_days", "showValue": "never", "stacking": "normal", "legend": { "showLegend": true, "placement": "right", "displayMode": "list" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-ct" },
          "editorType": "sql",
          "queryType": "table",
          "rawSql": "SELECT bin AS validity_days, sumIf(c, issuer = 'Let''s Encrypt') AS \"Let's Encrypt\", sumIf(c, issuer = 'Google Trust Services') AS \"Google Trust Services\", sumIf(c, issuer = 'ZeroSSL GmbH') AS \"ZeroSSL\", sumIf(c, issuer = 'Amazon') AS \"Amazon\", sumIf(c, issuer = 'GoDaddy.com') AS \"GoDaddy\", sumIf(c, issuer = 'DigiCert Inc') AS \"DigiCert\", sumIf(c, issuer = 'Microsoft Corporation') AS \"Microsoft\", sumIf(c, issuer = 'Sectigo Limited') AS \"Sectigo\", sumIf(c, issuer NOT IN ('Let''s Encrypt','Google Trust Services','ZeroSSL GmbH','Amazon','GoDaddy.com','DigiCert Inc','Microsoft Corporation','Sectigo Limited')) AS \"Other\" FROM (SELECT intDiv(dateDiff('day', not_before, not_after), 5) * 5 AS bin, issuer_o AS issuer, count() AS c FROM ct.certs WHERE is_ca = 0 AND dateDiff('day', not_before, not_after) BETWEEN 0 AND 400 AND $__timeFilter(seen) GROUP BY bin, issuer) GROUP BY bin ORDER BY bin WITH FILL FROM 0 TO 400 STEP 5"
        }
      ]
    }
  ]
}
